{
  "version": 2,
  "framework": "nextjs",
  "routes": [
    {
      "src": "/api/(.*)",
      "headers": {
        "x-middleware-next": "1"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "x-middleware-next": "1"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
